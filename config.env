# ============================================================
# XAnyLabeling Batch Annotation - ONE CONFIGURATION FILE
# ============================================================
# Edit this file only. The scripts and systemd jobs read this file
# every time they run. Do not edit the scripts to change settings.

# ---------------- NAS / DATASET ----------------
REMOTE="annotation_nas"
DATASET="ai_data_collection/test/new_dataset/n01494475"

# Real LOCAL SSD/HDD path. Do not use CIFS/NFS/SSHFS/rclone mount.
ROOT="/home/easemyai/nas_annotation_workspace"

# ---------------- BATCH WORKFLOW ----------------
# Number of images kept locally at one time.
BATCH_SIZE=100

# The systemd timer wakes the manager every minute; this value controls how
# often the manager is allowed to perform a normal background pass.
# sync_now.sh always forces one immediate pass.
SYNC_INTERVAL=1m

# Seconds a JSON must remain unchanged before it is considered stable.
ANNOTATION_STABLE_SECONDS=15
UPLOAD_GRACE_SECONDS=20

# ---------------- TRANSFER LIMITS ----------------
# Keep these conservative for NAS stability.
TRANSFERS=1
CHECKERS=1
SFTP_CONCURRENCY=1
BANDWIDTH=25
RETRIES=3
LOW_RETRIES=3
TIMEOUT="30s"
CONNECT_TIMEOUT="10s"
TRANSFER_TIMEOUT_SECONDS=1800

# ---------------- DISK / BACKUP SAFETY ----------------
FREE_SPACE_FACTOR=1.35
BACKUP_RETENTION_DAYS=2

# ---------------- MULTI-PC OPTIONAL ----------------
# One PC: 0 / 1
# Two PCs: PC1=0/2, PC2=1/2
WORKER_INDEX=0
WORKER_COUNT=1

# ---------------- DATA / CONFLICT POLICY ----------------
IMAGE_EXTENSIONS="jpg,jpeg,png,bmp,webp,tif,tiff"
EXCLUDE=".Trash/**,**/.Trash/**,**/.DS_Store,**/.thumbnails/**"
CONFLICT_MODE="mtime_size"
VERIFY_MODE="size"

# ---------------- PROGRAM PATHS ----------------
RCLONE_BIN="rclone"
XANYLABELING="xanylabeling"
NOTIFY=1

# ============================================================
# USER RULE:
# Change settings here and rerun the affected command if needed.
# Examples:
#   BATCH_SIZE=100
#   ROOT="/mnt/my_ssd/annotation"
#   DATASET="ai_data_collection/anpr_selection/dataset"
#   BANDWIDTH="20M"
#   WORKER_INDEX=1
#   WORKER_COUNT=2
# ============================================================
