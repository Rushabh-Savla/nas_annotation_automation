# ==============================================================================
# Central Annotation Platform - Environment Configuration Template
# NOTE: Copy to .env and configure. Never commit secrets to version control.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_SECRET_KEY=replace_with_64_char_cryptographically_secure_random_key
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Connection Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=annotation_db
POSTGRES_USER=annotation_user
POSTGRES_PASSWORD=replace_with_strong_random_password
DATABASE_URL=postgresql://annotation_user:replace_with_strong_random_password@postgres:5432/annotation_db

# One-time Secure Bootstrap Admin Token (CLI only, invalidated upon admin creation)
BOOTSTRAP_ADMIN_TOKEN=replace_with_random_one_time_bootstrap_token

# Batch & Assignment Policies
DEFAULT_BATCH_SIZE=100
MAX_ASSIGNMENT_COUNT=10000
HEARTBEAT_INTERVAL_SECONDS=30
LEASE_DURATION_SECONDS=120
LEASE_GRACE_SECONDS=60

# File Catalog & Extensions
SUPPORTED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp,webp,tif,tiff
EXCLUDED_PATTERNS=.Trash/**,**/.Trash/**,**/.DS_Store,**/.thumbnails/**,**/tmp/**

# Storage & NAS Workspace Roots
# Canonical dataset root is read-only; assignments staged to workspace root
DEFAULT_REMOTE_NAME=annotation_nas
DATASET_ROOT=ai_data_collection
ANNOTATION_WORKSPACE_ROOT=annotation_workspaces
# Output policy: 'WORKSPACE' (default, safe: keeps outputs in workspace) or 'SIDECAR_PUBLISH'
ANNOTATION_OUTPUT_POLICY=WORKSPACE

# Rclone & Worker Transfer Policies
RCLONE_CONFIG_PATH=/secrets/rclone.conf
RCLONE_BIN=rclone
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=2
RCLONE_SFTP_CONCURRENCY=2
RCLONE_BANDWIDTH=25M
RCLONE_TIMEOUT=30s
RCLONE_CONNECT_TIMEOUT=10s
TRANSFER_TIMEOUT_SECONDS=1800

# Storage & Upload Bounds
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB per annotation JSON
STAGING_MAX_DISK_PERCENT=90

# ==============================================================================
# Production NAS Direct Credentials (Auto-generates Rclone config on startup)
# ==============================================================================
NAS_STORAGE_TYPE=sftp        # Protocol: sftp, smb, webdav, or local
NAS_HOST=                    # NAS hostname or IP (e.g. 192.168.1.100)
NAS_PORT=22                  # Port (e.g. 22 for sftp, 445 for smb)
NAS_USER=                    # NAS username
NAS_PASSWORD=                # NAS password
NAS_KEY_FILE=                # Optional path to private SSH key (e.g. /secrets/id_rsa)
NAS_ROOT_PATH=               # Optional base root path on NAS


